generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  password_hash String

  loginChallenges     LoginChallenge[]
  refreshTokens       RefreshToken[]
  orders              Order[]
  userShopCashInfos   UserShopCashInfos[]
  resetPasswordToken  ResetPasswordToken[]
}

model LoginChallenge {
  id          String    @id @default(uuid())
  user_id     Int
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([id])
}

model RefreshToken {
  id                   String   @id @default(uuid())
  user_id              Int      @unique
  refresh_token_hash   String
  expires_at           DateTime
  created_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Product {
  id             String  @id @default(uuid())
  sku            String
  supplier_price Int
  quantity       Int
  order          Order?  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_id       String?

  @@index([id])
}

model Order {
  id         String    @id @default(uuid())
  id_seller  String    @unique
  user_id    Int
  revenue    Decimal?
  profit     Decimal?
  is_paid    Boolean   @default(false)
  products   Product[]
  sold_date  DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([id])
}

model UserShopCashInfos { 
  id                    String      @id @default(uuid())
  user_id               Int         @unique
  total_shop_revenue    Decimal     @default(0.0)
  total_shop_profit     Decimal     @default(0.0)
  total_supplier_price  Decimal     @default(0.0)

  user                  User        @relation(fields: [user_id], references: [id], onDelete: Cascade) 
}

model ResetPasswordToken {
  id                    String      @id @default(uuid())  
  user_id               Int
  token_hash            String
  expires_at            DateTime
  used_at               DateTime?
  created_at            DateTime    @default(now())

  user User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
